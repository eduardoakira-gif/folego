# Copie para .env e preencha. NUNCA envie o .env para o GitHub (já está no .gitignore).
# Usado pelo deploy.sh (computador) — no GitHub, os mesmos nomes viram "Secrets" do repositório.

# --- Supabase (supabase.com → seu projeto → Settings) ---
SUPABASE_PROJECT_REF=abcdefghijklmnop          # o código que aparece na URL do projeto
SUPABASE_DB_PASSWORD=                          # a senha que você definiu ao criar o projeto
SUPABASE_ACCESS_TOKEN=                         # supabase.com/dashboard/account/tokens

# --- Open Finance (dashboard.pluggy.ai → sua aplicação) ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Meu Pluggy (grátis, só suas contas): mostra só o conector Meu Pluggy e libera só o seu e-mail
PLUGGY_CONNECTOR_IDS=200
PLUGGY_ALLOWED_EMAILS=seu-email@gmail.com

# --- WhatsApp (developers.facebook.com → seu app → WhatsApp) ---
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=invente-um-texto-qualquer
WA_NOTIFY_TEMPLATE=aviso_financeiro

# --- Opcional: perguntas livres no WhatsApp ---
ANTHROPIC_API_KEY=
AI_DAILY_LIMIT=30

# --- Endereço do site (para liberar o acesso do navegador) ---
APP_ORIGINS=https://SEU-USUARIO.github.io

# Gerados automaticamente pelo deploy.sh se ficarem vazios:
PLUGGY_WEBHOOK_SECRET=
CRON_SECRET=
